# Pipeline outputs. Predictions and per-task metrics are large and regenerable,
# so only the aggregated tables are tracked: they are the experimental results a
# reader needs to check the paper without rerunning the benchmark.
results/*
!results/aggregated/
results/aggregated/*
!results/aggregated/*.tsv
!results/generalization/
results/generalization/*
!results/generalization/*.tsv
!results/unit_comparison/
results/unit_comparison/*
!results/unit_comparison/*.tsv

# Figures — PDFs are regenerable from .py scripts; only PNGs are tracked
figures/*.pdf

# Snakemake
.snakemake/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Conda
.conda/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
battleamp-snakemake.tar.gz
tmp/

# Caches
__pycache__/
.ipynb_checkpoints/
figure4_cache/
figure_supp_mic_cache/

# Large data archives (tracked via DVC or external)
*.tar.gz
*.zip

# Temporary / one-off scripts
discover.sh
discover_results.sh

# Intermediate files
paired_MD.tsv
paired_MD_predictions.tsv
