"""
AMP Benchmark Pipeline (battleamp-snakemake)
=============================================
A general-purpose Snakemake pipeline for benchmarking antimicrobial peptide
prediction models. Model-agnostic, dataset-agnostic.

Usage:
    snakemake --profile profile/                                    # full benchmark
    snakemake --profile profile/ score                              # inference only
    snakemake --profile profile/ score --config fasta="/data/x.fasta"         # one-off FASTA
    snakemake --profile profile/ --config run_models="ampeppy,amplify"
"""

import json
import os
import re
import sys
import yaml
from pathlib import Path

# Each model rule carries a conda: directive, but Snakemake silently ignores
# those without --use-conda and runs every model in the ambient environment --
# where their setup.sh pip installs then collide. Fail fast instead.
from snakemake.settings.types import DeploymentMethod

if DeploymentMethod.CONDA not in workflow.deployment_settings.deployment_method:
    raise WorkflowError(
        "This pipeline requires --use-conda. Run it via the profile:\n"
        "    snakemake --profile profile/ [targets]"
    )

# With a conda env already active, `conda activate <model env>` replaces it on
# PATH instead of prepending -- so a virtualenv layered on top stays in front
# and every model runs against the venv's interpreter, not its own env.
if os.environ.get("VIRTUAL_ENV") and os.environ.get("CONDA_PREFIX"):
    raise WorkflowError(
        "A conda environment and a virtualenv are both active; models would "
        "silently run against the virtualenv instead of their own conda env.\n"
        "Run 'conda deactivate' until no (base) prefix remains, then re-run."
    )

configfile: "config/config.yaml"


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

REPO_ROOT = Path(workflow.basedir).parent  # one level up from workflow/
MODELS_DIR = (REPO_ROOT / "models").resolve()
DATASETS_DIR = REPO_ROOT  # dataset paths in config are relative to repo root
OUTPUT_DIR = Path("results")
SEQ_COL = config.get("sequence_column", "sequence")


# ---------------------------------------------------------------------------
# Model selection: --config run_models="model1,model2" overrides config.yaml
# ---------------------------------------------------------------------------

_run_models_override = config.get("run_models", None)
if _run_models_override:
    _requested = [m.strip() for m in str(_run_models_override).split(",") if m.strip()]
    _known = set(config["models"])
    _unknown = [m for m in _requested if m not in _known]
    if _unknown:
        raise ValueError(
            f"\n\n"
            f"  ERROR: Unknown model(s) in run_models: {', '.join(_unknown)}\n"
            f"  Available models (from config.yaml): {', '.join(sorted(_known))}\n"
        )
    config["models"] = _requested


# ---------------------------------------------------------------------------
# Load model metadata
# ---------------------------------------------------------------------------

MODELS = {}
for model_name in config["models"]:
    model_yaml_path = MODELS_DIR / model_name / "model.yaml"
    if not model_yaml_path.exists():
        raise FileNotFoundError(
            f"Model metadata not found: {model_yaml_path}\n"
            f"Each model directory must contain a model.yaml file."
        )
    with open(model_yaml_path) as f:
        MODELS[model_name] = yaml.safe_load(f)


# ---------------------------------------------------------------------------
# Resolve conda env paths per model
# ---------------------------------------------------------------------------

MODEL_ENV_PATHS = {}
for model_name in MODELS:
    env_path = MODELS_DIR / model_name / "environment.yaml"
    if not env_path.exists():
        # Without an env spec, `conda:` resolves to None and the model's
        # setup.sh / inference.sh run in whatever environment Snakemake
        # itself lives in -- so `pip install` in setup.sh pollutes it.
        raise FileNotFoundError(
            f"Model environment not found: {env_path}\n"
            f"Each model directory must contain an environment.yaml so that "
            f"Snakemake can isolate it. See docs/adding_a_model.md."
        )
    MODEL_ENV_PATHS[model_name] = str(env_path.resolve())


# ---------------------------------------------------------------------------
# Drop setup markers whose conda env is gone
# ---------------------------------------------------------------------------
#
# setup.sh pip-installs into the env, so a rebuilt env needs setup re-run. The
# env path is only known during deployment, after the DAG is built, so
# model_setup records it and we reconcile here instead.

# workflow.dryrun is still False here: it reads the executor plugin, which is
# not set during parsing. output_settings is.
if not getattr(workflow.output_settings, "dryrun", False):
    for model_name in MODELS:
        _done = OUTPUT_DIR / "setup" / model_name / ".setup_done"
        _record = OUTPUT_DIR / "setup" / model_name / "env.txt"
        if not (_done.exists() and _record.exists()):
            continue
        _prefix = _record.read_text().strip()
        if _prefix and not Path(_prefix).is_dir():
            logger.info(f"{model_name}: conda env gone, forcing re-setup")
            _done.unlink()


# ---------------------------------------------------------------------------
# Expand variants
# ---------------------------------------------------------------------------
#
# Models come in two flavours:
#
# 1. Standard models (possibly with variants that pass different args to
#    inference.sh). Each variant triggers a separate inference run.
#
# 2. Multi-output models (multioutput: true in model.yaml). A single
#    inference run produces prediction files for ALL variants at once.
#    Each variant declares a predictions_file that names its output.
#    This avoids running expensive ensembles multiple times.

VARIANTS = {}
MULTIOUTPUT_MODELS = {}   # model_name -> {"primary": first_variant, "variants": {name: predictions_file}}

for model_name, meta in MODELS.items():
    base_info = {
        "model": model_name,
        "type": meta["type"],
        "length_min": meta.get("length_min"),
        "length_max": meta.get("length_max"),
        "gpu": meta.get("gpu_required", False),
        "env": MODEL_ENV_PATHS[model_name],
    }

    if meta.get("multioutput") and meta.get("variants"):
        # Multi-output model: one inference run, many prediction files.
        variant_defs = meta["variants"]
        primary_variant = variant_defs[0]["name"]
        MULTIOUTPUT_MODELS[model_name] = {
            "primary": primary_variant,
            "variants": {
                v["name"]: v.get("predictions_file", "predictions.tsv")
                for v in variant_defs
            },
        }
        for v in variant_defs:
            VARIANTS[v["name"]] = {
                **base_info,
                "type": v.get("type", base_info["type"]),  # per-variant override
                "args": v.get("args", []),
                "multioutput": True,
                "predictions_file": v.get("predictions_file", "predictions.tsv"),
            }
    elif meta.get("variants"):
        # Standard multi-variant model (separate inference per variant).
        for v in meta["variants"]:
            VARIANTS[v["name"]] = {
                **base_info,
                "args": v.get("args", []),
            }
    else:
        # Single-variant model (variant name == model name).
        VARIANTS[model_name] = {
            **base_info,
            "args": [],
        }


# ---------------------------------------------------------------------------
# Wildcard helpers for multioutput vs standard inference rules
# ---------------------------------------------------------------------------

MULTIOUTPUT_VARIANT_NAMES = sorted(
    v for v, info in VARIANTS.items() if info.get("multioutput")
)
STANDARD_VARIANT_NAMES = sorted(
    v for v, info in VARIANTS.items() if not info.get("multioutput")
)

def _names_to_re(names):
    """Build a regex alternation that matches exactly the given names."""
    if not names:
        return r"(?!x)x"  # never-match pattern
    return "|".join(re.escape(n) for n in names)

MULTIOUTPUT_VARIANT_RE = _names_to_re(MULTIOUTPUT_VARIANT_NAMES)
STANDARD_VARIANT_RE = _names_to_re(STANDARD_VARIANT_NAMES)
MULTIOUTPUT_MODEL_RE = _names_to_re(sorted(MULTIOUTPUT_MODELS.keys()))


# ---------------------------------------------------------------------------
# Aggregated output mode: --config output="/path/to/results.csv"
# ---------------------------------------------------------------------------
# Writes one aggregated table -- a row per peptide, a column per model variant --
# to the given path once the run finishes, plus a sibling <stem>.report.json
# saying which models failed and which peptides were rejected.
#
#   snakemake --profile profile/ score \
#       --config fasta="/data/x.fasta" run_models="ampeppy,amplify" \
#                output="/data/results.csv" unit="uM"
#
# The table is written by the onsuccess/onerror handlers at the bottom of this
# file rather than by a rule, because a rule taking predictions.tsv as input
# cannot run when a model fails -- and with keep-going, a failed model is
# exactly the case the web service has to survive.
#
# Setting output= also switches the dataset name from the FASTA filename stem to a
# hash of its cleaned sequences.  Two users uploading different files both named
# peptides.fasta would otherwise share a dataset name, and the second would
# silently receive the first one's cached predictions.

_output_path = config.get("output", None)
_output_unit = config.get("unit", config.get("benchmark_unit", "ug/ml"))

if _output_path:
    sys.path.insert(0, str(REPO_ROOT))
    from battleamp import aggregate as _bamp_aggregate
    from battleamp import api as _bamp_api
    from battleamp import sequences as _bamp_sequences
    from battleamp import units as _bamp_units

    if _output_unit not in _bamp_units.VALID_UNITS:
        raise ValueError(
            f"\n\n"
            f"  ERROR: Unknown unit '{_output_unit}' passed via --config unit=\n"
            f"  Valid units: {', '.join(_bamp_units.VALID_UNITS)}\n"
        )

    if not config.get("fasta"):
        raise ValueError(
            f"\n\n"
            f"  ERROR: --config output= also requires --config fasta=\n"
            f"  The aggregated table is built for one uploaded FASTA.\n"
        )

    # Staging runs on dry runs too. It writes one small, content-addressed copy
    # of the input -- a pipeline *input*, not an output -- and skipping it would
    # make --dryrun both wrong and useless here: the DAG would be planned against
    # the filename-stem dataset instead of the hashed one, and would then fail on
    # the missing staged FASTA.
    _output_src = Path(config["fasta"]).resolve()
    if not _output_src.exists():
        raise FileNotFoundError(
            f"\n\n"
            f"  ERROR: FASTA file not found: {_output_src}\n"
        )
    _output_accepted, _output_rejected = _bamp_sequences.classify_records(
        _bamp_sequences.parse_fasta(_output_src.read_text())
    )
    if not _output_accepted:
        raise ValueError(
            f"\n\n"
            f"  ERROR: No scorable sequences in {_output_src}\n"
            f"  Every record was rejected (empty, gaps, D-amino acids or\n"
            f"  non-standard residues). Check the file before running.\n"
        )
    _output_dataset, _output_staged = _bamp_api.stage_fasta(_output_accepted)
    # Hand the staged copy to the fasta block below, so the dataset it
    # registers is the content-addressed one.
    config["fasta"] = str(_output_staged)
    logger.info(
        f"output mode: {len(_output_accepted)} sequences "
        f"({len(_output_rejected)} rejected) -> dataset {_output_dataset}"
    )


# ---------------------------------------------------------------------------
# On-the-fly dataset: --config fasta="/path/to/sequences.fasta"
# ---------------------------------------------------------------------------
# Registers an unnamed FASTA as a temporary dataset without requiring a
# config.yaml entry.  The dataset name is derived from the filename stem
# (e.g. "my_peptides" from "/data/my_peptides.fasta").
# Automatically restricts scoring to this dataset only, unless
# score_datasets is also explicitly provided on the command line.

_fasta_override = config.get("fasta", None)
if _fasta_override:
    _fasta_path = Path(_fasta_override).resolve()
    if not _fasta_path.exists():
        raise FileNotFoundError(
            f"\n\n"
            f"  ERROR: FASTA file not found: {_fasta_path}\n"
        )
    _fasta_dataset_name = _fasta_path.stem
    if _fasta_dataset_name in config.get("datasets", {}):
        raise ValueError(
            f"\n\n"
            f"  ERROR: Dataset name '{_fasta_dataset_name}' derived from the fasta "
            f"filename already exists in config.yaml.\n"
            f"  Rename your file or register the dataset in the config explicitly.\n"
        )
    config.setdefault("datasets", {})[_fasta_dataset_name] = {
        "sequences": str(_fasta_path),
        "_adhoc": True,
    }
    if "score_datasets" not in config:
        config["score_datasets"] = [_fasta_dataset_name]


# ---------------------------------------------------------------------------
# Dataset and task definitions
# ---------------------------------------------------------------------------

DATASETS = config.get("datasets", {})
TASKS = config["tasks"]


def get_variants_for_task(task_name):
    """Return variant names that can run on this task."""
    task = TASKS[task_name]
    required_types = task.get("model_type", None)

    if required_types is None:
        return list(VARIANTS.keys())

    if isinstance(required_types, str):
        required_types = [required_types]

    return [v for v, info in VARIANTS.items()
            if info["type"] in required_types]


def get_dataset_fasta(dataset_name):
    """Resolve the FASTA path for a dataset."""
    ds = DATASETS[dataset_name]
    p = Path(ds["sequences"])
    return str(p if p.is_absolute() else (REPO_ROOT / p).resolve())


def get_task_labels(task_name):
    """Resolve the labels TSV path for a task."""
    return str((REPO_ROOT / TASKS[task_name]["labels"]).resolve())


# ---------------------------------------------------------------------------
# Collect all expected outputs
# ---------------------------------------------------------------------------

ALL_METRICS = []
for task_name in TASKS:
    for variant in get_variants_for_task(task_name):
        ALL_METRICS.append(
            f"{OUTPUT_DIR}/evaluation/{variant}/{task_name}/metrics.json"
        )

# Inference-only outputs (for the "score" target).
# By default, all datasets are scored.  Override with:
#   --config score_datasets="[my-peptides]"
SCORE_DATASETS = config.get("score_datasets", list(DATASETS.keys()))
if isinstance(SCORE_DATASETS, str):
    SCORE_DATASETS = [SCORE_DATASETS]

ALL_PREDICTIONS = []
for variant in VARIANTS:
    for dataset_name in SCORE_DATASETS:
        ALL_PREDICTIONS.append(
            f"{OUTPUT_DIR}/inference/{variant}/{dataset_name}/predictions.tsv"
        )

# ---------------------------------------------------------------------------
# Include rule files
# ---------------------------------------------------------------------------

include: "rules/setup.smk"
include: "rules/clean.smk"
include: "rules/prefilter.smk"
include: "rules/inference.smk"
include: "rules/evaluate.smk"
include: "rules/aggregate.smk"


# ---------------------------------------------------------------------------
# Target rules
# ---------------------------------------------------------------------------

rule all:
    input:
        f"{OUTPUT_DIR}/aggregated/summary.tsv",

# The table is produced by a rule so that it is still written when every
# prediction is already cached: handlers do not fire on a "Nothing to be done"
# run, which for a web service is the common case of a second user submitting
# peptides someone else already scored.
#
# The rule cannot be the whole story, though: its inputs are the per-model
# predictions, so it is skipped entirely when a model fails. The onerror handler
# below covers that. Between them every outcome writes a table except a failure
# before any job ran, where nothing exists to tabulate.
OUTPUT_TABLE = _output_path or f"{OUTPUT_DIR}/.output_table_disabled.csv"


rule output_table:
    """Write the aggregated per-peptide table (only requested when output= is set)."""
    input:
        ALL_PREDICTIONS,
    output:
        table = OUTPUT_TABLE,
    run:
        _write_output_path(True)


rule score:
    """Run all models on the configured datasets (inference only, no evaluation)."""
    input:
        ALL_PREDICTIONS + ([OUTPUT_TABLE] if _output_path else []),


# ---------------------------------------------------------------------------
# Aggregated output table (only when --config output= was given)
# ---------------------------------------------------------------------------

def _write_output_path(snakemake_ok):
    """Write the aggregated table and its report, whatever the run did.

    No-op unless --config output= was given.

    Called from both onsuccess and onerror so the two paths cannot diverge.
    A non-zero Snakemake exit is normal here: keep-going means one failed model
    fails the workflow while the rest produced perfectly good predictions, and
    those still have to reach the user.

    Never raises. A bug in reporting must not be mistaken for a pipeline
    failure, so problems are logged and swallowed.
    """
    if not _output_path:
        return
    try:
        table_path = Path(_output_path)
        table_path.parent.mkdir(parents=True, exist_ok=True)

        # _output_src, NOT config["fasta"]: the output= block above replaced the latter
        # with the staged, already-cleaned copy. Validating that would report
        # zero rejected records, hiding exactly the peptides the user needs to
        # be told about.
        raw_text = _output_src.read_text()
        accepted, _ = _bamp_sequences.classify_records(
            _bamp_sequences.parse_fasta(raw_text)
        )
        validation = json.loads(
            _bamp_api.validate(raw_text, models=config["models"])
        )
        # NB: do not name a local `report` here -- Snakemake reserves `report`
        # as a directive keyword and its parser rejects the assignment.
        payload = _bamp_api.build_report(
            dataset=_output_dataset,
            model_names=config["models"],
            unit=_output_unit,
            validation=validation,
            accepted=accepted,
            proc={
                "status": "ok" if snakemake_ok else "partial",
                "command": "snakemake (in-process)",
                "returncode": 0 if snakemake_ok else 1,
                "stderr_tail": [],
            },
        )

        table_path.write_text(
            _bamp_aggregate.rows_to_delimited(
                payload["columns"],
                payload["rows"],
                delimiter=_bamp_aggregate.delimiter_for(table_path),
            )
        )
        sidecar = _bamp_aggregate.report_path_for(table_path)
        sidecar.write_text(json.dumps(payload, indent=2))

        logger.info(
            f"table: {len(payload['rows'])} peptides x "
            f"{len(payload['columns'])} model columns -> {table_path}"
        )
        logger.info(f"report: {sidecar} (status: {payload['status']})")
    except Exception as e:  # noqa: BLE001
        logger.error(f"web output failed: {type(e).__name__}: {e}")


# onsuccess/onerror must sit at column 0: Snakemake only recognises them as
# directives at the top level, so the output= guard lives inside the function.
onsuccess:
    _write_output_path(True)


onerror:
    _write_output_path(False)