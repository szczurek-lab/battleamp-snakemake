"""
AMP Benchmark Pipeline (battleamp-snakemake)
=============================================
A general-purpose Snakemake pipeline for benchmarking antimicrobial peptide
prediction models. Model-agnostic, dataset-agnostic.

Usage:
    snakemake --snakefile workflow/Snakefile --cores 4
    snakemake --snakefile workflow/Snakefile --use-conda --cores 8 --resources gpu=1
"""

import yaml
from pathlib import Path

configfile: "config/config.yaml"


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

REPO_ROOT = Path(workflow.basedir).parent  # one level up from workflow/
MODELS_DIR = (REPO_ROOT / "models").resolve()
DATASETS_DIR = REPO_ROOT  # dataset paths in config are relative to repo root
OUTPUT_DIR = Path("results")
SEQ_COL = config.get("sequence_column", "sequence")


# ---------------------------------------------------------------------------
# Load model metadata
# ---------------------------------------------------------------------------

MODELS = {}
for model_name in config["models"]:
    model_yaml_path = MODELS_DIR / model_name / "model.yaml"
    if not model_yaml_path.exists():
        raise FileNotFoundError(
            f"Model metadata not found: {model_yaml_path}\n"
            f"Each model directory must contain a model.yaml file."
        )
    with open(model_yaml_path) as f:
        MODELS[model_name] = yaml.safe_load(f)


# ---------------------------------------------------------------------------
# Resolve conda env paths per model
# ---------------------------------------------------------------------------

MODEL_ENV_PATHS = {}
for model_name in MODELS:
    env_path = MODELS_DIR / model_name / "environment.yaml"
    if env_path.exists():
        MODEL_ENV_PATHS[model_name] = str(env_path.resolve())
    else:
        MODEL_ENV_PATHS[model_name] = None  # no model-specific env


# ---------------------------------------------------------------------------
# Expand variants
# ---------------------------------------------------------------------------

VARIANTS = {}
for model_name, meta in MODELS.items():
    base_info = {
        "model": model_name,
        "type": meta["type"],
        "length_min": meta.get("length_min"),
        "length_max": meta.get("length_max"),
        "gpu": meta.get("gpu_required", False),
        "env": MODEL_ENV_PATHS[model_name],
    }
    if meta.get("variants"):
        for v in meta["variants"]:
            VARIANTS[v["name"]] = {
                **base_info,
                "args": v.get("args", []),
            }
    else:
        VARIANTS[model_name] = {
            **base_info,
            "args": [],
        }


# ---------------------------------------------------------------------------
# Dataset and task definitions
# ---------------------------------------------------------------------------

DATASETS = config.get("datasets", {})
TASKS = config["tasks"]


def get_variants_for_task(task_name):
    """Return variant names that can run on this task (matched by model_type)."""
    task = TASKS[task_name]
    required_type = task.get("model_type", "classifier")
    return [v for v, info in VARIANTS.items() if info["type"] == required_type]


def get_dataset_fasta(dataset_name):
    """Resolve the FASTA path for a dataset."""
    ds = DATASETS[dataset_name]
    return str((REPO_ROOT / ds["sequences"]).resolve())


def get_task_labels(task_name):
    """Resolve the labels TSV path for a task."""
    return str((REPO_ROOT / TASKS[task_name]["labels"]).resolve())


# ---------------------------------------------------------------------------
# Collect all expected outputs
# ---------------------------------------------------------------------------

ALL_METRICS = []
for task_name in TASKS:
    for variant in get_variants_for_task(task_name):
        ALL_METRICS.append(
            f"{OUTPUT_DIR}/evaluation/{variant}/{task_name}/metrics.json"
        )


# ---------------------------------------------------------------------------
# Include rule files
# ---------------------------------------------------------------------------

include: "rules/setup.smk"
include: "rules/prefilter.smk"
include: "rules/inference.smk"
include: "rules/evaluate.smk"
include: "rules/aggregate.smk"


# ---------------------------------------------------------------------------
# Target rules
# ---------------------------------------------------------------------------

rule all:
    input:
        f"{OUTPUT_DIR}/aggregated/summary.tsv",
