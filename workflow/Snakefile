"""
AMP Benchmark Pipeline (battleamp-snakemake)
=============================================
A general-purpose Snakemake pipeline for benchmarking antimicrobial peptide
prediction models. Model-agnostic, dataset-agnostic.

Usage:
    snakemake --profile profile/                                    # full benchmark
    snakemake --profile profile/ score                              # inference only
    snakemake --profile profile/ score --config fasta="/data/x.fasta"         # one-off FASTA
    snakemake --profile profile/ --config run_models="ampeppy,amplify"
"""

import re
import yaml
from pathlib import Path

# Note: --use-conda is enforced via profile/config.yaml.
# Each model rule carries a conda: directive; Snakemake will error on those
# rules if --use-conda is not active.

configfile: "config/config.yaml"


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

REPO_ROOT = Path(workflow.basedir).parent  # one level up from workflow/
MODELS_DIR = (REPO_ROOT / "models").resolve()
DATASETS_DIR = REPO_ROOT  # dataset paths in config are relative to repo root
OUTPUT_DIR = Path("results")
SEQ_COL = config.get("sequence_column", "sequence")


# ---------------------------------------------------------------------------
# Model selection: --config run_models="model1,model2" overrides config.yaml
# ---------------------------------------------------------------------------

_run_models_override = config.get("run_models", None)
if _run_models_override:
    _requested = [m.strip() for m in str(_run_models_override).split(",") if m.strip()]
    _known = set(config["models"])
    _unknown = [m for m in _requested if m not in _known]
    if _unknown:
        raise ValueError(
            f"\n\n"
            f"  ERROR: Unknown model(s) in run_models: {', '.join(_unknown)}\n"
            f"  Available models (from config.yaml): {', '.join(sorted(_known))}\n"
        )
    config["models"] = _requested


# ---------------------------------------------------------------------------
# Load model metadata
# ---------------------------------------------------------------------------

MODELS = {}
for model_name in config["models"]:
    model_yaml_path = MODELS_DIR / model_name / "model.yaml"
    if not model_yaml_path.exists():
        raise FileNotFoundError(
            f"Model metadata not found: {model_yaml_path}\n"
            f"Each model directory must contain a model.yaml file."
        )
    with open(model_yaml_path) as f:
        MODELS[model_name] = yaml.safe_load(f)


# ---------------------------------------------------------------------------
# Resolve conda env paths per model
# ---------------------------------------------------------------------------

MODEL_ENV_PATHS = {}
for model_name in MODELS:
    env_path = MODELS_DIR / model_name / "environment.yaml"
    if env_path.exists():
        MODEL_ENV_PATHS[model_name] = str(env_path.resolve())
    else:
        MODEL_ENV_PATHS[model_name] = None  # no model-specific env


# ---------------------------------------------------------------------------
# Expand variants
# ---------------------------------------------------------------------------
#
# Models come in two flavours:
#
# 1. Standard models (possibly with variants that pass different args to
#    inference.sh). Each variant triggers a separate inference run.
#
# 2. Multi-output models (multioutput: true in model.yaml). A single
#    inference run produces prediction files for ALL variants at once.
#    Each variant declares a predictions_file that names its output.
#    This avoids running expensive ensembles multiple times.

VARIANTS = {}
MULTIOUTPUT_MODELS = {}   # model_name -> {"primary": first_variant, "variants": {name: predictions_file}}

for model_name, meta in MODELS.items():
    base_info = {
        "model": model_name,
        "type": meta["type"],
        "length_min": meta.get("length_min"),
        "length_max": meta.get("length_max"),
        "gpu": meta.get("gpu_required", False),
        "env": MODEL_ENV_PATHS[model_name],
    }

    if meta.get("multioutput") and meta.get("variants"):
        # Multi-output model: one inference run, many prediction files.
        variant_defs = meta["variants"]
        primary_variant = variant_defs[0]["name"]
        MULTIOUTPUT_MODELS[model_name] = {
            "primary": primary_variant,
            "variants": {
                v["name"]: v.get("predictions_file", "predictions.tsv")
                for v in variant_defs
            },
        }
        for v in variant_defs:
            VARIANTS[v["name"]] = {
                **base_info,
                "type": v.get("type", base_info["type"]),  # per-variant override
                "args": v.get("args", []),
                "multioutput": True,
                "predictions_file": v.get("predictions_file", "predictions.tsv"),
            }
    elif meta.get("variants"):
        # Standard multi-variant model (separate inference per variant).
        for v in meta["variants"]:
            VARIANTS[v["name"]] = {
                **base_info,
                "args": v.get("args", []),
            }
    else:
        # Single-variant model (variant name == model name).
        VARIANTS[model_name] = {
            **base_info,
            "args": [],
        }


# ---------------------------------------------------------------------------
# Wildcard helpers for multioutput vs standard inference rules
# ---------------------------------------------------------------------------

MULTIOUTPUT_VARIANT_NAMES = sorted(
    v for v, info in VARIANTS.items() if info.get("multioutput")
)
STANDARD_VARIANT_NAMES = sorted(
    v for v, info in VARIANTS.items() if not info.get("multioutput")
)

def _names_to_re(names):
    """Build a regex alternation that matches exactly the given names."""
    if not names:
        return r"(?!x)x"  # never-match pattern
    return "|".join(re.escape(n) for n in names)

MULTIOUTPUT_VARIANT_RE = _names_to_re(MULTIOUTPUT_VARIANT_NAMES)
STANDARD_VARIANT_RE = _names_to_re(STANDARD_VARIANT_NAMES)
MULTIOUTPUT_MODEL_RE = _names_to_re(sorted(MULTIOUTPUT_MODELS.keys()))


# ---------------------------------------------------------------------------
# On-the-fly dataset: --config fasta="/path/to/sequences.fasta"
# ---------------------------------------------------------------------------
# Registers an unnamed FASTA as a temporary dataset without requiring a
# config.yaml entry.  The dataset name is derived from the filename stem
# (e.g. "my_peptides" from "/data/my_peptides.fasta").
# Automatically restricts scoring to this dataset only, unless
# score_datasets is also explicitly provided on the command line.

_fasta_override = config.get("fasta", None)
if _fasta_override:
    _fasta_path = Path(_fasta_override).resolve()
    if not _fasta_path.exists():
        raise FileNotFoundError(
            f"\n\n"
            f"  ERROR: FASTA file not found: {_fasta_path}\n"
        )
    _fasta_dataset_name = _fasta_path.stem
    if _fasta_dataset_name in config.get("datasets", {}):
        raise ValueError(
            f"\n\n"
            f"  ERROR: Dataset name '{_fasta_dataset_name}' derived from the fasta "
            f"filename already exists in config.yaml.\n"
            f"  Rename your file or register the dataset in the config explicitly.\n"
        )
    config.setdefault("datasets", {})[_fasta_dataset_name] = {
        "sequences": str(_fasta_path),
        "_adhoc": True,
    }
    if "score_datasets" not in config:
        config["score_datasets"] = [_fasta_dataset_name]


# ---------------------------------------------------------------------------
# Dataset and task definitions
# ---------------------------------------------------------------------------

DATASETS = config.get("datasets", {})
TASKS = config["tasks"]


def get_variants_for_task(task_name):
    """Return variant names that can run on this task."""
    task = TASKS[task_name]
    required_types = task.get("model_type", None)

    if required_types is None:
        return list(VARIANTS.keys())

    if isinstance(required_types, str):
        required_types = [required_types]

    return [v for v, info in VARIANTS.items()
            if info["type"] in required_types]


def get_dataset_fasta(dataset_name):
    """Resolve the FASTA path for a dataset."""
    ds = DATASETS[dataset_name]
    p = Path(ds["sequences"])
    return str(p if p.is_absolute() else (REPO_ROOT / p).resolve())


def get_task_labels(task_name):
    """Resolve the labels TSV path for a task."""
    return str((REPO_ROOT / TASKS[task_name]["labels"]).resolve())


# ---------------------------------------------------------------------------
# Collect all expected outputs
# ---------------------------------------------------------------------------

ALL_METRICS = []
for task_name in TASKS:
    for variant in get_variants_for_task(task_name):
        ALL_METRICS.append(
            f"{OUTPUT_DIR}/evaluation/{variant}/{task_name}/metrics.json"
        )

# Inference-only outputs (for the "score" target).
# By default, all datasets are scored.  Override with:
#   --config score_datasets="[my-peptides]"
SCORE_DATASETS = config.get("score_datasets", list(DATASETS.keys()))
if isinstance(SCORE_DATASETS, str):
    SCORE_DATASETS = [SCORE_DATASETS]

ALL_PREDICTIONS = []
for variant in VARIANTS:
    for dataset_name in SCORE_DATASETS:
        ALL_PREDICTIONS.append(
            f"{OUTPUT_DIR}/inference/{variant}/{dataset_name}/predictions.tsv"
        )

# ---------------------------------------------------------------------------
# Include rule files
# ---------------------------------------------------------------------------

include: "rules/setup.smk"
include: "rules/clean.smk"
include: "rules/prefilter.smk"
include: "rules/inference.smk"
include: "rules/evaluate.smk"
include: "rules/aggregate.smk"


# ---------------------------------------------------------------------------
# Target rules
# ---------------------------------------------------------------------------

rule all:
    input:
        f"{OUTPUT_DIR}/aggregated/summary.tsv",

rule score:
    """Run all models on the configured datasets (inference only, no evaluation)."""
    input:
        ALL_PREDICTIONS,